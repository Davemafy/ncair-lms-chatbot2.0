# Assessed V2: official N-ATLaS model.
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_DEVICE=auto
# Use 4bit on 16 GB GPUs such as NVIDIA T4; keep none for full-precision deployment.
NATLAS_QUANTIZATION=none
NATLAS_MAX_NEW_TOKENS=320

# Optional for Hugging Face access. Leave empty for public unauthenticated access.
HF_TOKEN=

# Retrieval.
# V1 keeps the original all-MiniLM FAISS path and MIN_RETRIEVAL_SCORE.
TOP_K=3
MIN_RETRIEVAL_SCORE=0.30

# V2 uses multilingual E5 over atomic official facts, then BGE cross-encoder reranking.
# Keep these models on CPU so N-ATLaS owns the GPU memory.
EMBEDDING_DEVICE=cpu
V2_EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
# The official fact corpus is tiny; this default lets the reranker see the whole corpus.
RERANK_CANDIDATES=64
# BGE raw logits are sigmoid-normalized before thresholding.
RERANK_MIN_SCORE=0.50
RERANK_MIN_MARGIN=0.00

# Browser origins allowed to call the API when frontend and backend are separate.
NCAIR_ALLOWED_ORIGINS=https://ncair-lms-chatbotv1.vercel.app,https://tbotv1.vercel.app

# V1 baseline only.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Which implementation /api/chat should use. Explicit /api/v1/chat and /api/v2/chat
# are always available.
NCAIR_DEFAULT_VERSION=v2
