# Assessed V2: official N-ATLaS model.
NATLAS_MODEL=NCAIR1/N-ATLaS
NATLAS_DEVICE=auto
# Use 4bit on 16 GB GPUs such as NVIDIA T4; keep none for full-precision deployment.
NATLAS_QUANTIZATION=none
NATLAS_MAX_NEW_TOKENS=320

# Optional for Hugging Face access. Leave empty for public unauthenticated access.
HF_TOKEN=

# Retrieval.
TOP_K=3
MIN_RETRIEVAL_SCORE=0.30

# V1 baseline only.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Which implementation /api/chat should use. Explicit /api/v1/chat and /api/v2/chat
# are always available.
NCAIR_DEFAULT_VERSION=v2
